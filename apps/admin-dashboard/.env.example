# ─────────────────────────────────────────────────────────────────────────────
# Example environment. Copy to .env.local and fill in REAL values.
# This file is committed, so it must NEVER contain a real secret — placeholders only.
# In production the app fails to boot if any secret below is unset or left at a default
# (see src/lib/secrets.ts and docs/SECURITY-AUDIT-2026-07.md).
# Generate a strong value with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection (host where docker container exposes 5432).
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=sixsenai
# REQUIRED in prod. Do not reuse the old committed value; rotate it on the DB (ALTER ROLE).
PG_PASSWORD=change-me-strong-db-password

# HMAC secret for the session cookie. REQUIRED in prod (32+ random bytes).
# Leaking this lets an attacker forge sessions for any persona, including SUPER_ADMIN.
SESSION_SECRET=change-me-32-byte-random-base64

# Dedicated secret for device-signature / outbound-callback signing. REQUIRED in prod.
# Must be DISTINCT from SESSION_SECRET.
FIFO_WEBHOOK_SECRET=change-me-32-byte-random-base64

# Dedicated key the Android agent uses to sign device-route requests (HMAC). REQUIRED in
# prod once the signed agent is deployed. MUST match the APK's AGENT_SIGNING_SECRET
# (keystore.properties -> agentSigningSecret). Distinct from FIFO_WEBHOOK_SECRET.
AGENT_SIGNING_SECRET=change-me-32-byte-random-base64

# Credential-vault master key, base64(32 bytes). REQUIRED in prod.
# Rotating this needs a re-seal migration — run tools/reseal-vault.mjs BEFORE setting it
# for the first time, or existing sealed secrets become undecryptable.
VAULT_MASTER_KEY=

# Cron endpoint auth key (status-sweep, email-poll, payu-verify, payu-payout-verify, daily,
# telegram-daily, monitor, reserve-release). Also authenticates the /api/metrics scrape
# unless METRICS_TOKEN is set.
FIFO_CRON_KEY=change-me-cron-key
# METRICS_TOKEN=change-me-metrics-token

# Admin Telegram bot: the daily report and the ops alerts (lib/ops-alert). Alerts are
# recorded but not sent while these are unset.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_IDS=
# TELEGRAM_WEBHOOK_SECRET=

# Platform pay-in limits (lib/payin-limits), in rupees. A banker's own limits, set on the
# merchant page, win. 0 switches a default off.
# PAYIN_MIN_AMOUNT=1                 # smallest live order (default 1)
# PAYIN_UPI_MAX_AMOUNT=100000        # largest order paid by UPI link (default 100000)
# PAYIN_DEFAULT_DAILY_AMOUNT=        # a banker's live total for one day (default: none)
# PAYIN_DEFAULT_MAX_TPS=             # orders a banker may create in one second (default: none)

# Confirmation window (lib/katana-pay), in seconds. The customer always has 15 minutes to pay; a
# live gateway order is then kept PENDING this much longer before the merchant is told Expired.
# Off (0) by default. Pick it from "95% confirmed in" on the Gateway health page. At most 86400.
# PAYIN_CONFIRM_WINDOW_SECONDS=        # every gateway
# PAYIN_CONFIRM_WINDOW_SECONDS_PAYU=   # one gateway; wins over the line above (0 = none for it)

# Live activation (lib/live-activation).
# LIVE_MIN_TEST_PAYMENTS=1           # successful test payments the checklist asks for (default 1)
# LIVE_AUTO_ACTIVATE=1               # approve a request at once when the checklist is complete (default: a Super Admin approves)

# Bank statement push (POST /api/v1/bank-feeds/<BANK_CODE>). One secret per bank; the push is
# refused until its secret is set. Uploads by staff and the cron key need no secret.
# BANK_FEED_SECRET_HDFC=change-me

# Onboarding (lib/onboarding-gates). A gate that FAILS always refuses the step. Set to 1 to
# make a gate that needs REVIEW refuse it too (a Super Admin can still override with a note).
# ONBOARDING_STRICT=1

# Gateway health (lib/gateway-performance): an alert when fewer than MIN_RATE of a gateway's
# last SAMPLE ended orders were paid, once at least MIN_SAMPLE have ended.
# GATEWAY_HEALTH_MIN_RATE=0.65
# GATEWAY_HEALTH_SAMPLE=50
# GATEWAY_HEALTH_MIN_SAMPLE=20

# Payment mail (lib/email-sender-check). A mail is acted on only when the mailbox's own server
# authenticated it as coming from a payment provider's domain.
# PAYMENT_EMAIL_DOMAINS=example-bank.co.in   # more sender domains, comma-separated
# EMAIL_SENDER_CHECK=report                  # act on unverified mail too and only record it (default: enforce)
# EMAIL_AUTHSERV_ID=mx.google.com            # the mail server whose authentication result is believed

# Circuit breaker (lib/circuit-breaker).
# CIRCUIT_THRESHOLD=5                # failures in a row that open a circuit
# CIRCUIT_COOLDOWN_S=180             # seconds before the probe (default 180 in prod, 60 in dev)

# Demo password accepted by /api/auth/login for un-migrated seeded users.
# IGNORED in production (the demo-login path is disabled there). Dev convenience only.
DEMO_PASSWORD=demo

# ── Sandbox / migration toggles ──────────────────────────────────────────────
# Allow the `x-sandbox: 1` auth bypass on callback/device routes in NON-production only.
# ALLOW_SANDBOX_AUTH=1
#
# TRANSITION FLAG: keep the x-sandbox bypass working on the DEVICE routes in production
# while the deployed Android agent still authenticates with x-sandbox (it does not yet
# sign its requests). REMOVE this once the signed agent is rolled out fleet-wide — until
# then the device-ingestion endpoints remain forgeable (audit C2). Leave UNSET to close them.
# LEGACY_SANDBOX_AGENTS=1

# Session cookie Secure flag. Unset = Secure in production, off in dev.
# Set to "false" when serving over plain HTTP (no TLS), otherwise the browser
# drops the Secure session cookie and login appears to fail. Set "true" to force.
# COOKIE_SECURE=false

# Support assistant (lib/support-bot). Without the key the assistant answers 503 NOT_CONFIGURED.
ANTHROPIC_API_KEY=
# Merchants (PROVIDER) and bankers (MERCHANT) get the assistant in their portals when this is 1.
# Off by default: staff test it at /support-bot first.
SUPPORT_BOT_PORTALS=0
# Questions a merchant or banker may ask per day (India time). Default 100.
# SUPPORT_BOT_DAILY_LIMIT=100
# "off" sends every question to the strongest model instead of choosing per question.
# SUPPORT_BOT_ROUTING=off
