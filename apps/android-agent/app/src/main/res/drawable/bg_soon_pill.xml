<?xml version="1.0" encoding="utf-8"?>
<!-- Small outlined pill tagging a payment-app row that carries no switch. Was the "SOON"
     tag for apps whose capture engine wasn't built yet; now marks BharatPe, which needs no
     engine because its capture happens off the phone entirely (the payment email). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_variant" />
    <stroke android:width="1dp" android:color="@color/outline" />
    <corners android:radius="20dp" />
</shape>
