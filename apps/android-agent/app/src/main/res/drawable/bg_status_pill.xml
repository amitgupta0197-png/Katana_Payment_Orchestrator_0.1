<?xml version="1.0" encoding="utf-8"?>
<!-- Status pill behind "CAPTURING" / "PAUSED". Tinted at runtime (setBackgroundTintList) so one
     shape serves every state and the colour is decided by the same code that decides the words. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="#1A3FE0A0" />
</shape>
